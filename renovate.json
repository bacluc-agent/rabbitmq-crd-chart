{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track rabbitmq/cluster-operator tags in Chart.yaml",
      "managerFilePatterns": ["Chart\\.yaml"],
      "matchStrings": ["rabbitmq-operator-version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "rabbitmq/cluster-operator",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["rabbitmq/cluster-operator"],
      "commitMessageTopic": "rabbitmq cluster-operator",
      "prBodyNotes": [
        "Upstream release: https://github.com/rabbitmq/cluster-operator/releases. The `Refresh CRD` GitHub Actions workflow regenerates `templates/crd/rabbitmqclusters.rabbitmq.com.yaml` from the pinned version and commits it into this PR automatically."
      ]
    }
  ]
}